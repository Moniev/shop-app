<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
    <style type="text/css">
      body {
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      }
    </style>
  </head>
  <body style="margin: 0; padding: 0; background-color: #e0e5ec; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">
    <table border="0" cellpadding="0" cellspacing="0" width="100%">
      <tr>
        <td style="padding: 20px 0 20px 0;">
          <table align="center" border="0" cellpadding="0" cellspacing="0" width="600" style="border-collapse: collapse;">
            <tr>
              <td align="center" style="
                padding: 40px;
                background-color: #e0e5ec;
                border-radius: 30px;
                box-shadow: 9px 9px 16px #bebeca, -9px -9px 16px #ffffff;
              ">
                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                  <tr>
                    <td style="
                      padding: 0 0 20px 0;
                      color: #5a6470;
                      font-size: 24px;
                      font-weight: bold;
                      text-align: center;
                      text-shadow: 0px 0px 4px rgba(255, 255, 255, 0.5);
                    ">
                      Password Reset Request
                    </td>
                  </tr>
                  <tr>
                    <td style="padding: 20px 0 20px 0; color: #5a6470; font-size: 16px; line-height: 1.6; text-align: left;">
                      Hi there, <%= @user.mail %>.
                    </td>
                  </tr>
                  <tr>
                    <td style="padding: 0 0 20px 0; color: #5a6470; font-size: 16px; line-height: 1.6; text-align: left;">
                      We received a request to reset your password. Use the code below to set up a new one. For your security, it will expire in 2 hours.
                    </td>
                  </tr>
                  <tr>
                    <td align="center" style="padding: 20px 0 20px 0;">
                      <div style="
                        padding: 20px;
                        border-radius: 15px;
                        background-color: #e0e5ec;
                        box-shadow: inset 7px 7px 15px #bebeca, inset -7px -7px 15px #ffffff;
                        color: #0d6efd;
                        font-size: 28px;
                        font-weight: bold;
                        letter-spacing: 4px;
                        text-align: center;
                        text-shadow: 0 0 5px rgba(255,255,255,0.7), 0 0 10px #0d6efd, 0 0 15px #0d6efd;
                      ">
                        <%= @code %>
                      </div>
                    </td>
                  </tr>
                  <tr>
                    <td style="padding: 20px 0 0 0; color: #86909a; font-size: 14px; line-height: 1.6; text-align: left;">
                      If you didn't request this change, you can safely ignore this email. No changes have been made to your account.
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>